{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pricing-2",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/safety-portal-compliance",
      "destination": "/safety-portal-maintenance",
      "permanent": true
    },
    {
      "source": "/product/safety-portal-maintenance",
      "destination": "/safety-portal-maintenance",
      "permanent": true
    },
    {
      "source": "/product/oshawise-subscription",
      "destination": "/osha-msha",
      "permanent": true
    },
    {
      "source": "/product/mshawise",
      "destination": "/osha-msha",
      "permanent": true
    },
    {
      "source": "/product/maintenance-plan",
      "destination": "/fix-my-site",
      "permanent": true
    },
    {
      "source": "/product/security-plan",
      "destination": "/fix-my-site",
      "permanent": true
    },
    {
      "source": "/product/performance-plan",
      "destination": "/fix-my-site",
      "permanent": true
    },
    {
      "source": "/product/:slug*",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/product-category/:slug*",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/comments/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tag/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/author/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/pricing",
      "permanent": false
    },
    {
      "source": "/checkout",
      "destination": "/pricing",
      "permanent": false
    },
    {
      "source": "/shop",
      "destination": "/pricing",
      "permanent": false
    },
    {
      "source": "/my-account",
      "destination": "/pricing",
      "permanent": false
    },
    {
      "source": "/cart/:rest*",
      "destination": "/pricing",
      "permanent": false
    },
    {
      "source": "/checkout/:rest*",
      "destination": "/pricing",
      "permanent": false
    },
    {
      "source": "/wp-admin",
      "destination": "/admin/login.html",
      "permanent": false
    },
    {
      "source": "/wp-admin/:rest*",
      "destination": "/admin/login.html",
      "permanent": false
    },
    {
      "source": "/wp-login.php",
      "destination": "/admin/login.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(favicon.ico|og-image.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms(.*).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
